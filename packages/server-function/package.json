{
  "name": "@data2evidence/d2e-fhir-server",
  "version": "0.0.99",  
  "scripts": {
    "trex_build": "tbuild ."
  },
  "devDependencies": {
    "@trex/cli": "latest"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "trex": {
    "functions": {
      "init": [
        {
          "function": "/server/src",
          "imports": "/server/deno.json",
          "env": "d2e-fhir-server"
        }
      ],
      "api": [
        {
          "source": "/fhir-server",
          "function": "/server/src",
          "env": "d2e-fhir-server",
          "imports": "/server/deno.json"
        }
      ],
      "env": {
        "d2e-fhir-server": {
          "FHIR_SERVER_BASE_URL": "http://${PROJECT_NAME:-d2e}-trex.${TLS__INTERNAL__DOMAIN:-alp.local}:33001",
          "PG__PORT": "${PG__PORT}",
          "PG__HOST": "${PG__HOST}",
          "PG__DB_NAME": "${PG__DB_NAME}",
          "PG_SUPER_PASSWORD": "${PG_SUPER_PASSWORD}",
          "PG_SUPER_USER": "${PG_SUPER_USER:-postgres}",
          "FHIR__LOG_LEVEL": "debug",
          "FHIR_CUSTOM_SCHEMA": "${FHIR_CUSTOM_SCHEMA:-fhir}",
          "FHIR__CLIENT_ID": "${FHIR__CLIENT_ID:-${FHIR__CLIENT_ID:-db6b2304-f236-45ec-b10c-a852681e7129}}",
          "FHIR__CLIENT_SECRET": "${FHIR__CLIENT_SECRET}",
          "REDIS_PASSWORD": "${REDIS_PASSWORD}",
          "REDIS_HOST": "${REDIS_HOST:-${PROJECT_NAME:-d2e}-minerva-redis-1}",
          "REDIS_PORT": "${REDIS_PORT:-6379}",
          "BINARY_UPLOAD_LIMIT_SIZE": "${BINARY_UPLOAD_LIMIT_SIZE:-50mb}",
          "AUTH_RATE_LIMIT": "${AUTH_RATE_LIMIT:-1000}"
        }
      },
      "roles": {
        "ALP_SYSTEM_ADMIN": [
          "fhir.server.admin"
        ],
        "IDP_ALP_DATA_CLIENT_ID": [
          "fhir.server.admin"
        ]
      },
      "scopes": [
        {
          "path": "^/fhir-server/(.*)",
          "scopes": [
            "fhir.server.admin"
          ],
          "httpMethods": [
            "POST",
            "GET",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        }
      ]
    }
  }
}
